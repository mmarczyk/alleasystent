# ────────────────────────────────────────────────────────────────────────────
# AllEasystent — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=16000

# ── Facebook Messenger ────────────────────────────────────────────────────────
# Get these from https://developers.facebook.com/ → your Messenger app
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=alleasystent_verify_token   # set the same in FB dashboard
FACEBOOK_APP_SECRET=

# ── Allegro ───────────────────────────────────────────────────────────────────
# Get from https://apps.developer.allegro.pl/ → create an app (Device flow)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URI=http://localhost:8080/allegro/callback

# ── GCP ───────────────────────────────────────────────────────────────────────
# Leave blank to run fully locally (no Pub/Sub). Conversation history uses
# REDIS_URL below (in-memory if that's also blank) — unrelated to GCP.
GCP_PROJECT_ID=
GCP_REGION=europe-central2

# ── Redis ─────────────────────────────────────────────────────────────────────
# Conversation history + Allegro token cache. Leave blank to run fully
# in-memory (local dev only — history/tokens don't survive a restart).
REDIS_URL=

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_BACKEND=chromadb          # chromadb | vertex_ai
EMBEDDING_BACKEND=local       # local | vertex_ai
CHROMADB_PATH=./data/chromadb
RAG_TOP_K=5

# For Vertex AI (production):
# VERTEX_AI_INDEX_ENDPOINT=projects/.../locations/.../indexEndpoints/...
# VERTEX_AI_INDEX_ID=...

# ── Analytics dashboard (alleasystent-analytics repo, Google Sign-In) ─────────
# OAuth 2.0 Client ID (Web application) from GCP Console → APIs & Services →
# Credentials. Must match GOOGLE_CLIENT_ID configured in alleasystent-analytics.
ANALYTICS_GOOGLE_CLIENT_ID=
# Comma-separated Google account emails allowed to view the dashboard.
ANALYTICS_ALLOWED_EMAILS=
# GitHub Pages origin of alleasystent-analytics, e.g. https://mmarczyk.github.io
ANALYTICS_FRONTEND_URL=

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO
PORT=8080
